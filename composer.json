{
    "name": "marinailsapps/passorde-connect",
    "description": "Passorde Connect : le composant de connecteurs de l'application Passorde, installé avec elle. Premier connecteur : Passorde Connect — Evoliz, compatible avec Evoliz, non affilié à Evoliz SAS / Visma.",
    "type": "library",
    "license": "proprietary",
    "homepage": "https://apps.marinails.site/passorde",
    "support": {
        "email": "apps@marinails.site"
    },
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-sodium": "*",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/cache": "^12.0",
        "illuminate/console": "^12.0",
        "illuminate/contracts": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/log": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/support": "^12.0",
        "illuminate/translation": "^12.0",
        "illuminate/view": "^12.0",
        "nesbot/carbon": "^3.8"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Passorde\\": [
                "src/",
                "connectors/evoliz/src/"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Passorde\\Tests\\": [
                "tests/",
                "connectors/evoliz/tests/"
            ],
            "Passorde\\Testing\\": "testing/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Passorde\\PassordeServiceProvider",
                "Passorde\\Evoliz\\EvolizServiceProvider"
            ]
        }
    },
    "scripts": {
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G --no-progress",
        "test": "pest",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ],
        "third-party": "@php scripts/third-party.php",
        "post-update-cmd": [
            "@third-party"
        ]
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
